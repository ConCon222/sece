---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% if page.sitemap != false and page.url != nil %}{% unless page.url contains '/assets/' %}<url>
  <loc>{{ site.url }}{{ page.url | replace:'index.html','' }}</loc>{% if page.last_modified_at %}
  <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
</url>
{% endunless %}{% endif %}{% endfor %}{% for post in site.posts %}{% if post.sitemap != false %}<url>
  <loc>{{ site.url }}{{ post.url }}</loc>{% if post.last_modified_at %}
  <lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>{% elsif post.date %}
  <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>{% endif %}
</url>
{% endif %}{% endfor %}{% for collection in site.collections %}{% for doc in collection.docs %}{% if doc.sitemap != false %}<url>
  <loc>{{ site.url }}{{ doc.url }}</loc>{% if doc.last_modified_at %}
  <lastmod>{{ doc.last_modified_at | date_to_xmlschema }}</lastmod>{% elsif doc.date %}
  <lastmod>{{ doc.date | date_to_xmlschema }}</lastmod>{% endif %}
</url>
{% endif %}{% endfor %}{% endfor %}</urlset>