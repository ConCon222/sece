---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  {%- for post in site.posts -%}
    {%- if post.sitemap != false -%}
    <url>
      <loc>{{ site.url | strip_newlines | strip }}{{ site.baseurl | strip_newlines | strip }}{{ post.url | strip_newlines | strip }}</loc>
      {%- if post.last_modified_at -%}
      <lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>
      {%- elsif post.date -%}
      <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      {%- endif -%}
    </url>
    {%- endif -%}
  {%- endfor -%}

  {%- for page in site.html_pages -%}
    {%- if page.sitemap != false -%}
    <url>
      <loc>{{ site.url | strip_newlines | strip }}{{ site.baseurl | strip_newlines | strip }}{{ page.url | remove: "index.html" | strip_newlines | strip }}</loc>
    </url>
    {%- endif -%}
  {%- endfor -%}

</urlset>