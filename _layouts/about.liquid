  <!-- NEWS ─────────────────────────────────────────────── -->
  <section id="news" class="section">
    <div class="section-head">
      <span class="section-num">04</span>
      <h2 class="section-title">
        <span class="only-en">Recent <em>news</em></span>
        <span class="only-zh">近期<em>动态</em></span>
      </h2>
      <span class="section-rule"></span>
      <a class="section-link" href="{{ '/news/' | relative_url }}"><span class="only-en">All news →</span><span class="only-zh">全部动态 →</span></a>
    </div>

    <div class="news-rail">
      {% assign recent_news = site.news | sort: 'date' | reverse %}
      {% for item in recent_news limit: 4 %}
        {% assign tag_zh = item.tag %}
        {% case item.tag %}
          {% when 'milestone' %}{% assign tag_zh = '里程碑' %}
          {% when 'conference' %}{% assign tag_zh = '会议' %}
          {% when 'award' %}{% assign tag_zh = '奖项' %}
          {% when 'publication' %}{% assign tag_zh = '论文' %}
          {% when 'talk' %}{% assign tag_zh = '演讲' %}
        {% endcase %}
        <div class="news-card glass{% if item.highlight %} highlight{% endif %}">
          <div class="news-date"><span class="only-en">{{ item.date | date: '%b %Y' }}</span><span class="only-zh">{{ item.date | date: '%Y 年 %-m 月' }}</span></div>
          <div class="news-body">
            {% if item.tag %}<span class="news-tag"><span class="only-en">{{ item.tag }}</span><span class="only-zh">{{ tag_zh }}</span></span>{% endif %}
            <div class="only-en">{{ item.content }}</div>
            <div class="only-zh">{% if item.zh %}{{ item.zh | markdownify }}{% else %}{{ item.content }}{% endif %}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

