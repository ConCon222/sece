          </div>
        </div>

        <div class="stats">
          <div class="stat glass">
            <div class="stat-num">{{ pub_count }}</div>
            <div class="stat-label"><span class="only-en">Publications</span><span class="only-zh">论文</span></div>
          </div>
          <div class="stat glass">
            <div class="stat-num">{{ total_citations }}</div>
            <div class="stat-label"><span class="only-en">Citations</span><span class="only-zh">被引</span></div>
          </div>
          <div class="stat glass">
            <div class="stat-num">{{ h_index }}</div>
            <div class="stat-label"><span class="only-en">h-index</span><span class="only-zh">h 指数</span></div>
          </div>
          <a class="stat glass stat-link" href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener">
            <div class="stat-num gs">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M5.242 13.769L0.5 9.5 12 1l11.5 8.5-4.742 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
            </div>
            <div class="stat-label"><span class="only-en">Scholar →</span><span class="only-zh">学术主页 →</span></div>
          </a>
        </div>
      </div>

      <aside class="hero-portrait">
        <div class="portrait-frame glass">
          <img src="{{ '/assets/img/photo1.jpg' | relative_url }}" alt="Haoming Wang" />
